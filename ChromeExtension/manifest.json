{
    "manifest_version": 3,
    "name": "Website Productivity Tracker",
    "version": "1.0",
    "description": "Tracks time spent on websites and provides productivity analytics.",
    "permissions": ["tabs", "storage", "activeTab", "background"],
    "host_permissions": ["*://*/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
  